# Supabase
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Groq AI — NÃO usar VITE_ (seria exposto no bundle do cliente)
# Esta key é usada apenas pela Edge Function supabase/functions/ai/
GROQ_API_KEY=

# App URL
VITE_APP_URL=
VITE_APP_VERSION=0.1.0

# Sentry — monitorização de erros em produção
# Cria um projecto em https://sentry.io e copia o DSN aqui
VITE_SENTRY_DSN=

# PayPal
VITE_PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# SMTP Email
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# EMAIL_FROM=

# Segredo interno para autenticar o endpoint /api/send-email
# Gera um valor aleatório longo: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
EMAIL_API_SECRET=

# ── OAuth 2.0 (apps externas, ex: NetsulCondo) ───────────────
# URLs e durações do protocolo. O client_id e o client_secret da app
# cliente ficam em oauth_clients (ver supabase/migrations/*_oauth_server.sql)
OAUTH_CODE_TTL_SECONDS=600
OAUTH_TOKEN_TTL_SECONDS=3600
OAUTH_REFRESH_TTL_SECONDS=2592000

# URL base do NetsulCondo — usada para saber para onde devolver o browser
# depois de o utilizador autorizar
NETSULCONDO_APP_URL=http://localhost:3000
